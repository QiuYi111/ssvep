Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0; Start-Service sshd; Set-Service
  -Name sshd -StartupType 'Automatic'; New-NetFirewallRule -Name sshd -DisplayName 'OpenSSH Server'
  -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22;
  $ak='$env:USERPROFILE\.ssh\authorized_keys'; mkdir "$env:USERPROFILE\.ssh" -Force; "ssh-ed25519
  AAAAC3NzaC1lZDI1NTE5AAAAINiyn/0XsLqSzrEoT6rrgZTYIzXOJOl5x6pKsK4UK75f 2513868362@qq.com" | Out-File
   -FilePath $ak -Encoding ASCII; icacls $ak /inheritance:r /grant "$env:USERNAME`:F"; icacls
  "$env:USERPROFILE\.ssh" /inheritance:r /grant "$env:USERNAME`:F"; Write-Host "Done. IP:";
  Get-NetIPAddress -AddressFamily IPv4 | Where-Object {$_.InterfaceAlias -notlike "*Loopback*"} |
  Select-Object IPAddress, InterfaceAlias